{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": { "kind": "build", "isDefault": true },
			"presentation": { "reveal": "never" },
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "relative",
				"pattern": [
					{ "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
					{ "regexp": "^\\s+(.*):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
				],
				"background": {
					"activesBegin": "^\\[watch\\] build started",
					"endsPattern": "^\\[watch\\] build finished"
				}
			}
		},
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": ["$tsc"]
		},
		{
			"type": "npm",
			"script": "test:unit",
			"group": "test",
			"problemMatcher": []
		}
	]
}
