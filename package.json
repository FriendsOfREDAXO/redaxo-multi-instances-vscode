{
  "name": "redaxo-multi-instances-manager",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.0.1",
  "publisher": "skerbis",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FriendsOfREDAXO/redaxo-multi-instances-vscode.git"
  },
  "homepage": "https://github.com/FriendsOfREDAXO/redaxo-multi-instances-vscode",
  "bugs": {
    "url": "https://github.com/FriendsOfREDAXO/redaxo-multi-instances-vscode/issues"
  },
  "license": "MIT",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "keywords": [
    "redaxo",
    "cms",
    "docker",
    "php",
    "mariadb",
    "apache",
    "localhost",
    "https",
    "mkcert",
    "mailpit",
    "adminer",
    "mcp",
    "claude",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redaxo-instances",
          "title": "%viewContainer.title%",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "redaxo-instances": [
        {
          "id": "redaxo-instances.instancesView",
          "name": "%view.instances%",
          "icon": "$(server-environment)",
          "contextualTitle": "REDAXO"
        },
        {
          "id": "redaxo-instances.servicesView",
          "name": "%view.services%",
          "icon": "$(globe)",
          "contextualTitle": "REDAXO",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "redaxo-instances.instancesView",
        "when": "redaxo-instances.dockerAvailable == false",
        "contents": "%welcome.noDocker%"
      },
      {
        "view": "redaxo-instances.instancesView",
        "when": "redaxo-instances.dockerAvailable && !redaxo-instances.hasInstances",
        "contents": "%welcome.empty%"
      }
    ],
    "commands": [
      {
        "command": "redaxo-instances.createInstance",
        "title": "%command.createInstance%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "redaxo-instances.importInstance",
        "title": "%command.importInstance%",
        "category": "%category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "redaxo-instances.refresh",
        "title": "%command.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "redaxo-instances.startInstance",
        "title": "%command.startInstance%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "redaxo-instances.stopInstance",
        "title": "%command.stopInstance%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "redaxo-instances.restartInstance",
        "title": "%command.restartInstance%",
        "category": "%category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "redaxo-instances.stopAllInstances",
        "title": "%command.stopAllInstances%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "redaxo-instances.deleteInstance",
        "title": "%command.deleteInstance%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "redaxo-instances.openInBrowser",
        "title": "%command.openInBrowser%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "redaxo-instances.openBackend",
        "title": "%command.openBackend%",
        "category": "%category%",
        "icon": "$(home)"
      },
      {
        "command": "redaxo-instances.getLoginInfo",
        "title": "%command.getLoginInfo%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "redaxo-instances.showModernLoginInfo",
        "title": "%command.showModernLoginInfo%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "redaxo-instances.clearCache",
        "title": "%command.clearCache%",
        "category": "%category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "redaxo-instances.runConsoleCommand",
        "title": "%command.runConsoleCommand%",
        "category": "%category%",
        "icon": "$(terminal-cmd)"
      },
      {
        "command": "redaxo-instances.showRedaxoLogs",
        "title": "%command.showRedaxoLogs%",
        "category": "%category%",
        "icon": "$(file-text)"
      },
      {
        "command": "redaxo-instances.openInAdminer",
        "title": "%command.openInAdminer%",
        "category": "%category%",
        "icon": "$(database)"
      },
      {
        "command": "redaxo-instances.openTerminal",
        "title": "%command.openTerminal%",
        "category": "%category%",
        "icon": "$(terminal)"
      },
      {
        "command": "redaxo-instances.openDbShell",
        "title": "%command.openDbShell%",
        "category": "%category%",
        "icon": "$(database)"
      },
      {
        "command": "redaxo-instances.showLogs",
        "title": "%command.showLogs%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "redaxo-instances.openWorkspace",
        "title": "%command.openWorkspace%",
        "category": "%category%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "redaxo-instances.openInFinder",
        "title": "%command.openInFinder%",
        "category": "%category%",
        "icon": "$(folder)"
      },
      {
        "command": "redaxo-instances.changePhpVersion",
        "title": "%command.changePhpVersion%",
        "category": "%category%",
        "icon": "$(symbol-number)"
      },
      {
        "command": "redaxo-instances.changeMariaDbVersion",
        "title": "%command.changeMariaDbVersion%",
        "category": "%category%",
        "icon": "$(database)"
      },
      {
        "command": "redaxo-instances.toggleXdebug",
        "title": "%command.toggleXdebug%",
        "category": "%category%",
        "icon": "$(debug)"
      },
      {
        "command": "redaxo-instances.manageDomains",
        "title": "%command.manageDomains%",
        "category": "%category%",
        "icon": "$(link)"
      },
      {
        "command": "redaxo-instances.setupSSL",
        "title": "%command.setupSSL%",
        "category": "%category%",
        "icon": "$(lock)"
      },
      {
        "command": "redaxo-instances.createDatabase",
        "title": "%command.createDatabase%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "redaxo-instances.exportInstance",
        "title": "%command.exportInstance%",
        "category": "%category%",
        "icon": "$(export)"
      },
      {
        "command": "redaxo-instances.repairInstance",
        "title": "%command.repairInstance%",
        "category": "%category%",
        "icon": "$(tools)"
      },
      {
        "command": "redaxo-instances.modernizeInstance",
        "title": "%command.modernizeInstance%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "redaxo-instances.copyCopilotInstructions",
        "title": "%command.copyCopilotInstructions%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "redaxo-instances.setupClaude",
        "title": "%command.setupClaude%",
        "category": "%category%",
        "icon": "$(plug)"
      },
      {
        "command": "redaxo-instances.trustCertificates",
        "title": "%command.trustCertificates%",
        "category": "%category%",
        "icon": "$(shield)"
      },
      {
        "command": "redaxo-instances.startAdminer",
        "title": "%command.startAdminer%",
        "category": "%category%",
        "icon": "$(database)"
      },
      {
        "command": "redaxo-instances.stopAdminer",
        "title": "%command.stopAdminer%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "redaxo-instances.openMailpit",
        "title": "%command.openMailpit%",
        "category": "%category%",
        "icon": "$(mail)"
      },
      {
        "command": "redaxo-instances.startService",
        "title": "%command.startService%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "redaxo-instances.stopService",
        "title": "%command.stopService%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "redaxo-instances.maintenanceMenu",
        "title": "%command.maintenanceMenu%",
        "category": "%category%",
        "icon": "$(tools)"
      },
      {
        "command": "redaxo-instances.changeInstancesPath",
        "title": "%command.changeInstancesPath%",
        "category": "%category%",
        "icon": "$(folder)"
      },
      {
        "command": "redaxo-instances.showHelp",
        "title": "%command.showHelp%",
        "category": "%category%",
        "icon": "$(question)"
      },
      {
        "command": "redaxo-instances.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "%category%",
        "icon": "$(rocket)"
      },
      {
        "command": "redaxo-instances.openReadme",
        "title": "%command.openReadme%",
        "category": "%category%",
        "icon": "$(book)"
      },
      {
        "command": "redaxo-instances.showOutput",
        "title": "%command.showOutput%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "redaxo-instances.showInstanceContextMenu",
        "title": "%command.showInstanceContextMenu%",
        "category": "%category%",
        "icon": "$(list-flat)"
      },
      {
        "command": "redaxo-instances.updateHosts",
        "title": "%command.updateHosts%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "redaxo-instances.installCLITools",
        "title": "%command.installCLITools%",
        "category": "%category%",
        "icon": "$(tools)"
      },
      {
        "command": "redaxo-instances.openUrl",
        "title": "%command.openUrl%",
        "category": "%category%",
        "icon": "$(link-external)"
      },
      {
        "command": "redaxo-instances.copyValue",
        "title": "%command.copyValue%",
        "category": "%category%",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "redaxo-instances.createInstance",
          "when": "view == redaxo-instances.instancesView",
          "group": "navigation@1"
        },
        {
          "command": "redaxo-instances.refresh",
          "when": "view == redaxo-instances.instancesView",
          "group": "navigation@2"
        },
        {
          "command": "redaxo-instances.importInstance",
          "when": "view == redaxo-instances.instancesView",
          "group": "1_instances@1"
        },
        {
          "command": "redaxo-instances.stopAllInstances",
          "when": "view == redaxo-instances.instancesView",
          "group": "1_instances@2"
        },
        {
          "command": "redaxo-instances.setupClaude",
          "when": "view == redaxo-instances.instancesView",
          "group": "2_ai@1"
        },
        {
          "command": "redaxo-instances.maintenanceMenu",
          "when": "view == redaxo-instances.instancesView",
          "group": "3_settings@1"
        },
        {
          "command": "redaxo-instances.changeInstancesPath",
          "when": "view == redaxo-instances.instancesView",
          "group": "3_settings@2"
        },
        {
          "command": "redaxo-instances.showHelp",
          "when": "view == redaxo-instances.instancesView",
          "group": "navigation@3"
        },
        {
          "command": "redaxo-instances.showOutput",
          "when": "view == redaxo-instances.instancesView",
          "group": "4_help@2"
        },
        {
          "command": "redaxo-instances.trustCertificates",
          "when": "view == redaxo-instances.servicesView",
          "group": "1_https@1"
        },
        {
          "command": "redaxo-instances.openWalkthrough",
          "when": "view == redaxo-instances.instancesView",
          "group": "4_help@0"
        }
      ],
      "view/item/context": [
        {
          "command": "redaxo-instances.startInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance stopped/",
          "group": "inline@1"
        },
        {
          "command": "redaxo-instances.stopInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "inline@1"
        },
        {
          "command": "redaxo-instances.openBackend",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/ && viewItem =~ / redaxo$/",
          "group": "inline@2"
        },
        {
          "command": "redaxo-instances.openInBrowser",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/ && viewItem =~ / custom$/",
          "group": "inline@2"
        },
        {
          "command": "redaxo-instances.startInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance stopped/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "redaxo-instances.stopInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "redaxo-instances.restartInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "1_lifecycle@2"
        },
        {
          "command": "redaxo-instances.openBackend",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / redaxo$/",
          "group": "2_open@1"
        },
        {
          "command": "redaxo-instances.openInBrowser",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "2_open@2"
        },
        {
          "command": "redaxo-instances.getLoginInfo",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "2_open@3"
        },
        {
          "command": "redaxo-instances.openInAdminer",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "2_open@4"
        },
        {
          "command": "redaxo-instances.clearCache",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/ && viewItem =~ / redaxo$/",
          "group": "3_redaxo@1"
        },
        {
          "command": "redaxo-instances.runConsoleCommand",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/ && viewItem =~ / redaxo$/",
          "group": "3_redaxo@2"
        },
        {
          "command": "redaxo-instances.showRedaxoLogs",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / redaxo$/",
          "group": "3_redaxo@3"
        },
        {
          "command": "redaxo-instances.openTerminal",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "4_tools@1"
        },
        {
          "command": "redaxo-instances.openDbShell",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "4_tools@2"
        },
        {
          "command": "redaxo-instances.showLogs",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "4_tools@3"
        },
        {
          "command": "redaxo-instances.openWorkspace",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "4_tools@4"
        },
        {
          "command": "redaxo-instances.changePhpVersion",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / v2 /",
          "group": "5_config@1"
        },
        {
          "command": "redaxo-instances.changeMariaDbVersion",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "5_config@2"
        },
        {
          "command": "redaxo-instances.toggleXdebug",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / v2 /",
          "group": "5_config@3"
        },
        {
          "command": "redaxo-instances.manageDomains",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / v2 /",
          "group": "5_config@4"
        },
        {
          "command": "redaxo-instances.createDatabase",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance running/",
          "group": "5_config@5"
        },
        {
          "command": "redaxo-instances.modernizeInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance / && viewItem =~ / legacy /",
          "group": "5_config@0"
        },
        {
          "command": "redaxo-instances.copyCopilotInstructions",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "6_ai@1"
        },
        {
          "command": "redaxo-instances.exportInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "7_transfer@1"
        },
        {
          "command": "redaxo-instances.repairInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "7_transfer@2"
        },
        {
          "command": "redaxo-instances.deleteInstance",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^instance /",
          "group": "9_danger@1"
        },
        {
          "command": "redaxo-instances.copyValue",
          "when": "view == redaxo-instances.instancesView && viewItem =~ /^detail (url|secret)/",
          "group": "inline@1"
        },
        {
          "command": "redaxo-instances.startService",
          "when": "view == redaxo-instances.servicesView && viewItem =~ /^service .* stopped$/",
          "group": "inline@1"
        },
        {
          "command": "redaxo-instances.stopService",
          "when": "view == redaxo-instances.servicesView && viewItem =~ /^service .* running$/",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "redaxo-instances.showModernLoginInfo",
          "when": "false"
        },
        {
          "command": "redaxo-instances.startService",
          "when": "false"
        },
        {
          "command": "redaxo-instances.stopService",
          "when": "false"
        },
        {
          "command": "redaxo-instances.updateHosts",
          "when": "false"
        },
        {
          "command": "redaxo-instances.installCLITools",
          "when": "false"
        },
        {
          "command": "redaxo-instances.openUrl",
          "when": "false"
        },
        {
          "command": "redaxo-instances.copyValue",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "REDAXO Multi-Instances",
      "properties": {
        "redaxo-instances.instancesPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.instancesPath%",
          "order": 1
        },
        "redaxo-instances.dockerPath": {
          "type": "string",
          "default": "docker",
          "markdownDescription": "%config.dockerPath%",
          "order": 2
        },
        "redaxo-instances.instancesDirectory": {
          "type": "string",
          "markdownDeprecationMessage": "%config.instancesDirectory.deprecated%"
        },
        "redaxo-instances.defaultPhpVersion": {
          "type": "string",
          "markdownDeprecationMessage": "%config.defaultPhpVersion.deprecated%"
        },
        "redaxo-instances.defaultMariaDbVersion": {
          "type": "string",
          "markdownDeprecationMessage": "%config.defaultMariaDbVersion.deprecated%"
        },
        "redaxo-instances.autoRefresh": {
          "type": "boolean",
          "markdownDeprecationMessage": "%config.autoRefresh.deprecated%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "redaxo-instances.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "docker",
            "title": "%walkthrough.docker.title%",
            "description": "%walkthrough.docker.description%",
            "media": {
              "image": "resources/walkthrough.svg",
              "altText": "REDAXO"
            },
            "completionEvents": [
              "onContext:redaxo-instances.dockerAvailable"
            ]
          },
          {
            "id": "create",
            "title": "%walkthrough.create.title%",
            "description": "%walkthrough.create.description%",
            "media": {
              "image": "resources/walkthrough.svg",
              "altText": "REDAXO"
            },
            "completionEvents": [
              "onCommand:redaxo-instances.createInstance"
            ]
          },
          {
            "id": "https",
            "title": "%walkthrough.https.title%",
            "description": "%walkthrough.https.description%",
            "media": {
              "image": "resources/walkthrough.svg",
              "altText": "REDAXO"
            },
            "completionEvents": [
              "onCommand:redaxo-instances.trustCertificates"
            ]
          },
          {
            "id": "ai",
            "title": "%walkthrough.ai.title%",
            "description": "%walkthrough.ai.description%",
            "media": {
              "image": "resources/walkthrough.svg",
              "altText": "REDAXO"
            },
            "completionEvents": [
              "onCommand:redaxo-instances.setupClaude"
            ]
          },
          {
            "id": "redaxo6",
            "title": "%walkthrough.redaxo6.title%",
            "description": "%walkthrough.redaxo6.description%",
            "media": {
              "image": "resources/walkthrough.svg",
              "altText": "REDAXO"
            },
            "completionEvents": []
          }
        ]
      }
    ],
    "chatParticipants": [
      {
        "id": "redaxo-instances.chat",
        "name": "redaxo",
        "fullName": "REDAXO",
        "description": "%chat.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "help",
            "description": "%chat.command.help%"
          },
          {
            "name": "list",
            "description": "%chat.command.list%"
          },
          {
            "name": "info",
            "description": "%chat.command.info%"
          },
          {
            "name": "create",
            "description": "%chat.command.create%"
          },
          {
            "name": "start",
            "description": "%chat.command.start%"
          },
          {
            "name": "stop",
            "description": "%chat.command.stop%"
