# syntax=docker/dockerfile:1
# REDAXO Multi-Instances – shared web image (Apache + mod_php)
# Generated by the REDAXO Multi-Instances VS Code extension.
# The same Dockerfile is used for every instance; only build args differ, so
# Docker can share the image between all instances using the same PHP version.

ARG PHP_IMAGE_TAG=8.5-apache
FROM php:${PHP_IMAGE_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    COMPOSER_ALLOW_SUPERUSER=1 \
    APACHE_DOCUMENT_ROOT=/var/www/html/public

COPY --from=ghcr.io/mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# System tools that are useful inside a dev container (and needed by the setup)
# plus the media toolchain: ImageMagick, libvips, Poppler, Ghostscript, ffmpeg
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git unzip less nano vim-tiny \
        mariadb-client msmtp msmtp-mta locales \
        imagemagick libvips-tools poppler-utils ghostscript ffmpeg; \
    printf '%s\n' 'de_DE.UTF-8 UTF-8' 'en_GB.UTF-8 UTF-8' 'en_US.UTF-8 UTF-8' > /etc/locale.gen; \
    locale-gen; \
    rm -rf /var/lib/apt/lists/*

# PHP extensions required/recommended by REDAXO and common AddOns.
# imagick and xdebug are optional: release candidates of PHP are sometimes
# not supported yet – the image must still build in that case.
RUN set -eux; \
    install-php-extensions bcmath calendar exif ffi gd intl mbstring mysqli opcache pdo_mysql soap sockets zip; \
    install-php-extensions imagick || install-php-extensions imagick/imagick@master \
        || echo "WARNING: imagick is not available for this PHP version"; \
    install-php-extensions xdebug || install-php-extensions xdebug/xdebug@master \
        || echo "WARNING: xdebug is not available for this PHP version"; \
    rm -f /usr/local/etc/php/conf.d/*xdebug*.ini; \
    mkdir -p /usr/local/etc/php/available; \
    if php -r 'exit(extension_loaded("xdebug")?0:1);' 2>/dev/null || [ -n "$(find /usr/local/lib/php/extensions -name 'xdebug.so' -print -quit)" ]; then \
        printf '%s\n' 'zend_extension=xdebug' 'xdebug.mode=debug,develop' 'xdebug.client_host=host.docker.internal' \
            'xdebug.client_port=9003' 'xdebug.start_with_request=trigger' > /usr/local/etc/php/available/xdebug.ini; \
    fi

COPY php.ini /usr/local/etc/php/conf.d/90-redaxo.ini
COPY vhost.conf /etc/apache2/sites-available/000-default.conf
COPY entrypoint.sh /usr/local/bin/redaxo-entrypoint

RUN set -eux; \
    chmod 0755 /usr/local/bin/redaxo-entrypoint; \
    git config --system --add safe.directory '*'; \
    chown www-data:www-data /var/www; \
    a2enmod rewrite headers expires deflate remoteip setenvif; \
    a2dissite default-ssl >/dev/null 2>&1 || true

WORKDIR /var/www/html
ENTRYPOINT ["redaxo-entrypoint"]
CMD ["apache2-foreground"]
